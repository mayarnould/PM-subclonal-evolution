#Function ----------------------------------------------------------------------
GetGenesFromSeuratObject <- function(visium, gene_list, layer = "data") {
  genes_absent_from_seurat_object <- setdiff(gene_list, rownames(visium))
  if (length(genes_absent_from_seurat_object) == length(gene_list)) print("no genes are found in the seurat object")
  if (length(genes_absent_from_seurat_object) > 0)  print(glue::glue("Warning, the following genes are not present in the seurat object and therefore have been ignored for the score:
                   {paste(genes_absent_from_seurat_object, collapse = ', ')}"))
  GetAssayData(object = visium, 
               layer = layer)[intersect(rownames(visium), gene_list), , drop = F]
}

AddScoreAsMeanOfGenes <- function(visium,
                                  gene_list,
                                  score_name,
                                  layer = "data") {
  print(glue::glue("\n\ncreating a score and adding it to the metadata as {score_name}"))
  visium@meta.data[, score_name] <- apply(GetGenesFromSeuratObject(visium = visium,
                                                                   gene_list = gene_list,
                                                                   layer = layer),
                                          2, mean)
  return(visium)
}

