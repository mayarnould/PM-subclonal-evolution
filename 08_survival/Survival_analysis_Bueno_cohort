# Fisher exact test for histology ----------------
# load metadata ----------------------------------------------------------------
metadata <- read_xlsx(file.path("Annotation_Bueno.xlsx")) %>% 
  janitor::clean_names() %>% 
  select(rna_id, hitology_eval_based_on_percent, os_status, os_time)

# Load output clustering 
cluster <- read.table("clustering_k3_bueno.txt")
metadata$rna_id <- paste0("X", metadata$rna_id)

setdiff(metadata$rna_id, cluster$Tumeur)
setdiff(cluster$Tumeur, metadata$rna_id)

cluster <- cluster %>% 
  mutate(groups = case_when(Cluster == 1 ~ "sc-I",
                            Cluster == 2 ~ "sc-E",
                            Cluster == 3 ~ "sc-S")) %>% 
  mutate(rna_id = Tumeur)

metadata <- metadata %>% 
  filter(rna_id %in% cluster$Tumeur) 

metadata <- metadata %>% 
  left_join(cluster, by = "rna_id")

metadata$groups  <- factor(metadata$groups, levels = c("sc-E", "sc-I", "sc-S"))

metadata <- metadata %>% 
  filter(!hitology_eval_based_on_percent == "NA")

fisher.test(table(metadata$hitology_eval_based_on_percent , metadata$groups))


# Test for association with S.score ----------------
metadata <- read_xlsx(file.path("Annotation_Bueno.xlsx")) %>% 
  janitor::clean_names()

# Load output clustering 
cluster <- read.table("clustering_k3_bueno.txt")
metadata$rna_id <- paste0("X", metadata$rna_id)

cluster <- cluster %>% 
  mutate(groups = case_when(Cluster == 1 ~ "sc-I",
                            Cluster == 2 ~ "sc-E",
                            Cluster == 3 ~ "sc-S")) %>% 
  mutate(rna_id = Tumeur)

metadata <- metadata %>% 
  filter(rna_id %in% cluster$Tumeur) 

metadata <- metadata %>% 
  left_join(cluster, by = "rna_id")

metadata$groups  <- factor(metadata$groups, levels = c("sc-E", "sc-I", "sc-S"))
metadata$s_score_norm <- as.numeric(metadata$s_score_norm)

kruskal.test(s_score_norm ~ groups, data = metadata)
pairwise.wilcox.test(metadata$s_score_norm, metadata$groups, p.adjust.method = "BH")
