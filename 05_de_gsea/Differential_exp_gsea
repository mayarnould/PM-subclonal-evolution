################################################################################
# GSEA

# Load data
m_sapiens = msigdbr(species = "Homo sapiens")

m_list_hum_hallmark <- m_sapiens %>% 
  filter(gs_collection =="H") %>%
  split(x = .$gene_symbol, f = .$gs_name)

m_list_hum_REACTOME <- m_sapiens %>% 
  filter(gs_subcollection =="CP:REACTOME") %>%
  split(x = .$gene_symbol, f = .$gs_name)

m_list_hum_KEGG <- m_sapiens %>% 
  filter(gs_subcollection =="CP:KEGG_LEGACY") %>%
  split(x = .$gene_symbol, f = .$gs_name)

# Load the data that you want to test with information for pvalue and R or log2fc
ranks <- res$avg_log2FC
names(ranks)<- rownames(res)

ranks <- sort(ranks, decreasing = TRUE)

# RUN GSEA
set.seed(42)

collection_interest <- list(m_list_hum_hallmark, m_list_hum_REACTOME, m_list_hum_KEGG)[[1]]
fgseaRes <- fgsea(pathways = collection_interest,
                  stats = ranks,
                  eps = 0.0,
                  minSize=15,
                  maxSize=500
)

# LOOK at the RESULTS
head(fgseaRes[order(pval,decreasing = F), ])
fgseaRes <- fgseaRes[order(pval,decreasing = F)]


RES<- as.data.frame(fgseaRes)
RES$leadingEdge <- vapply(RES$leadingEdge, paste, collapse = ", ", character(1L))


write.table(RES, file=file.path("GSEA_output.txt"), quote=FALSE, row.names=TRUE, sep="\t")

# Plot
plotEnrichment(m_list_hum_hallmark[["HALLMARK_EPITHELIAL_MESENCHYMAL_TRANSITION"]],
