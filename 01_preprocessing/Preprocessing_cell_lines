# Function ---------------------------------------------------------
GetGenesFromSeuratObject <- function(MPM, gene_list, layer = "data", assay = "RNA") {
  genes_absent_from_seurat_object <- setdiff(gene_list, rownames(MPM))
  if (length(genes_absent_from_seurat_object) == length(gene_list)) stop("no genes are found in the seurat object")
  if (length(genes_absent_from_seurat_object) > 0)  print(glue::glue("Warning, the following genes are not present in the seurat object and therefore have been ignored for the score:
                   {paste(genes_absent_from_seurat_object, collapse = ', ')}"))
  DefaultAssay(MPM) <- assay
  GetAssayData(object = MPM, 
               layer = layer)[intersect(rownames(MPM), gene_list), , drop = F]
}


AddScoreAsMeanOfGenes <- function(MPM,
                                  gene_list,
                                  score_name,
                                  layer = "data",
                                  assay = "RNA") {
  print(glue::glue("\n\ncreating a score and adding it to the metadata as {score_name}"))
  MPM@meta.data[, score_name] <- apply(GetGenesFromSeuratObject(MPM = MPM,
                                                                gene_list = gene_list,
                                                                layer = layer,
                                                                assay = assay),
                                       2, mean)
  return(MPM)
}

