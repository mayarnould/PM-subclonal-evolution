library(Seurat)
library(dplyr)
library(readxl)

## ---------------------------------------------------------------------------
## 1. PARAMETERS
## ---------------------------------------------------------------------------

obj_path     <- "obj_scRNAseq_cell_lines.rds"
pc_files_path <- "pos_pc1_cell_lines.txt"

obj <- readRDS(obj_path)
pc_files <- read.table(pc_files_path)

obj <- obj %>% 
  AddMetaData(pc_files)

table_path   <- "Supplementary_Table 1-4.xlsx"

x <- read_xlsx(table_path, sheet = "Table S2.2", .name_repair = "minimal")
colnames(x) <- as.character(unlist(x[2, ])); x <- x[-c(1, 2), ]
gene_E <- na.omit(x$`Epithelioid markers`)
gene_S <- na.omit(x$`Sarcomatoid markers`)

obj$e_markers_bulk <- apply(GetAssayData(object=obj, slot="data", assay = "RNA")[gene_E,], 2, mean)
obj$s_markers_bulk <- apply(GetAssayData(object=obj, slot="data", assay = "RNA")[gene_S,], 2, mean)

obj@meta.data %>% 
  ggplot(aes(x = PC_1, y = s_markers_bulk)) +
  geom_point(aes(color = s_markers_bulk)) +
  scale_color_gradientn(colors = c('#FBF6B8', '#F5D8AE', '#E88976', '#9B4577', '#1B0A20')) +
  theme_bw() +
  labs(x = "PC 1", y = "Expression sarcomatoid markers from bulk") +
  theme(axis.text.x = element_text(size = 15, color = "black"),
        axis.title.x = element_text(size = 15), 
        axis.text.y = element_text(size = 15, color = "black"),
        axis.title.y = element_blank())

obj@meta.data %>% 
  ggplot(aes(x = PC_1, y = e_markers_bulk)) +
  geom_point(aes(color = e_markers_bulk)) +
  scale_color_gradientn(colors = c('#FBF6B8', '#F5D8AE', '#E88976', '#9B4577', '#1B0A20')) +
  theme_bw() +
  labs(x = "PC 1", y = "Expression epithelioid markers from bulk") +
  theme(axis.text.x = element_text(size = 15, color = "black"),
        axis.title.x = element_text(size = 15), 
        axis.text.y = element_text(size = 15, color = "black"),
        axis.title.y = element_blank())

cor.test(obj@meta.data$PC_1, obj@meta.data$s_markers_bulk, method = "spearman")
cor.test(obj@meta.data$PC_1, obj@meta.data$e_markers_bulk, method = "spearman")

