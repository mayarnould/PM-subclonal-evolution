# Function ---------------------------------------------------------------------
LoadRData = function(file.name,
                     print.dim = T,
                     print.real.name = T) {
  file.real.name = load(file.name, verbose = print.real.name)
  if (print.dim) cat("dimensions: ", dim(get(file.real.name)))
  return(get(file.real.name))
}

distCosine = function (m) {
  nsamp <- nrow(m)
  res <- matrix(NA, nrow = nsamp, ncol = nsamp)
  rownames(res) <- colnames(res) <- rownames(m)
  for (i in 1:nsamp) {
    for (j in 1:nsamp) {
      res[i, j] <- lsa::cosine(m[i, ], m[j, ])
    }
  }
  as.dist(1 - res)
}

