# Load data vst corrected ----------
corrected_vst <- read.table(file.path("vst_85s_linear_regression_cibersortX.txt"))

# Look for clustering only for E and S genes of single-cell data
gene_E_S <- read_xlsx(file.path("Supplementary_Table 1-4.xlsx"), sheet = "Table S3.2")
colnames(gene_E_S) <- gene_E_S[2, ]
gene_E_S <- gene_E_S[-c(1,2), ]  
gene_E <- gene_E_S$`Epithelioid markers`
gene_S <- gene_E_S$`Sarcomatoid markers`

genes_E_S <- c(gene_S, gene_E)

vst_filtered <- corrected_vst %>% 
  as.data.frame() %>% 
  filter(rownames(.) %in% genes_E_S)

# Load metadata files
metadata <- read_xlsx(file.path("Supplementary_Table 1-4.xlsx")) %>% 
  janitor::clean_names() %>% 
  filter(!is.na(supplementary_table_1_1_annotations_of_the_cohort_of_pleural_mesothelioma_frozen_tumor_samples)) %>% 
  magrittr::set_colnames(.[1,]) %>% 
  janitor::clean_names() %>% 
  filter(!tumors_id == "Tumors ID")

metadata$s_score <- as.numeric(metadata$s_score)

metadata <- metadata %>% 
  mutate(e_score = 1 - s_score)

metadata$tumors_id <- gsub("-", ".", metadata$tumors_id)


### ANNOTATION ####
if (!all(metadata$tumors_id == colnames(vst_filtered))) {
  print("WARNING: order is different so annotations won't match")
} else {
  print("order is the same in annotation and matrix -> keep going")
}

if (!all(metadata$tumors_id == colnames(vst_filtered))) {
  metadata <- metadata %>% 
    .[match(colnames(vst_filtered), .$tumors_id),]
}

if (!all(metadata$tumors_id == colnames(vst_filtered))) {
  print("WARNING: order is different so annotations won't match")
} else {
  print("order is the same in annotation and matrix -> keep going")
}

col_mut = c("M" = "#F09F57", "NA" = "grey90", "WT" = "white")
histo_cols <- c("E" = "#3194CA", "S" = "#B83243", "B" = "#D68340", "NA" = "grey90")
mut_types <- c("Epithelioid" = "#3e7d9c", "Sarcomatoid" = "#802525", "Non-differentiated" = "#6a3d98", 
               "Intermediate" = "#d678a3", "Sarcomatoid/Intermediate" = "#d678a3", "NA" = "grey90")
               

# Annotations
annotation_tumor <- HeatmapAnnotation(sn_types = anno_simple(metadata$phenotypic_single_cell_subtypes_based_on_sc_rna_seq,
                                                             width = unit(0.7, "cm"),
                                                             height = unit(0.5, "cm"),
                                                             mut_types),
                                      empty_2 = anno_empty(border = FALSE, height = unit(.02, "cm")),
                                      histology = anno_simple(metadata$histology,
                                                              width = unit(0.7, "cm"),
                                                              height = unit(0.5, "cm"),
                                                              col = histo_cols),
                                      empty_3 = anno_empty(border = FALSE, height = unit(.02, "cm")),
                                      E_S_score = anno_barplot(select(metadata, e_score, s_score), 
                                                               height = unit(0.8, "cm"),
                                                               bar_width = .95,
                                                               gp = gpar(fill = c("#b2d1e0", "#cb4d4d"))),
                                      empty_4 = anno_empty(border = FALSE, height = unit(.02, "cm")),
                                      BAP1 = anno_simple(metadata$bap1,
                                                         width = unit(0.7, "cm"),
                                                         height = unit(0.5, "cm"),
                                                         col_mut),
                                      TERT = anno_simple(metadata$ter_tprom,
                                                         width = unit(0.7, "cm"),
                                                         height = unit(0.5, "cm"),
                                                         col_mut),
                                      show_legend = F)

# Centrer gene
centering = TRUE

if (centering) {
  vst_filtered = vst_filtered - apply(vst_filtered, 1, . %>% median(., na.rm = T))
}

# Clustering
col_clust_cos <- hclust(dist(t(vst_filtered), method = "euclidian"), method = "ward.D2")

vst_filtered <- as.matrix(vst_filtered)

col_dend <- as.dendrogram(col_clust_cos)

col_dend <- rev(col_dend)

clustering_cos <- Heatmap(vst_filtered, 
                          name = NULL,
                          heatmap_legend_param = list(title = NULL),
                          cluster_columns = col_dend,
                          top_annotation = annotation_tumor, 
                          show_row_names = F,
                          show_column_names = F,
                          column_names_gp = gpar(fontsize = 10),
                          column_split = 4,
                          row_km = 2,
                          width = unit(18, "cm"),
                          height = unit(11, "cm"))
clustering_cos



png(file.path(plot_dir, "Deconvolution_clustering/Deconv_CIBERSORT_linear_regression_E_S_final.png"), 
    width = 1000, height = 1000, res = 120)
print(clustering_cos)
dev.off()

svg(file.path("Deconv_CIBERSORT_linear_regression_E_S_final.svg"), width = 1100/120, height = 800/120)
print(clustering_cos)
dev.off()

column_groups <- cutree(col_clust_cos, k = 4)

cluster_data <- data.frame(
  Tumeur = names(column_groups),
  Cluster = as.factor(column_groups)
)

write.table(cluster_data, file.path(files_dir, "k4_clustering_tumor_sample.txt"), sep = "\t")






