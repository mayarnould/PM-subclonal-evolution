# BULK

# load metadata ----------------------------------------------------------------
metadata_bulk_cl <- read_xlsx(file.path("Supplementary_Table 1-4.xlsx"), sheet = "Table S1.2") %>% 
  janitor::clean_names() %>% 
  filter(!is.na(supplementary_table_1_2_annotations_of_the_cohort_of_pleural_mesothelioma_patient_derived_primary_cell_lines)) %>%
  magrittr::set_colnames(.[1, ]) %>%
  janitor::clean_names() %>%
  filter(!cell_lines_id == "Cell lines ID")

metadata_bulk_cl$phenotypic_single_cell_subtypes_based_on_bulk_rna_seq <- factor(metadata_bulk_cl$phenotypic_single_cell_subtypes_based_on_bulk_rna_seq,
                                                                  levels = c("Epithelioid", "Non-differentiated", "Intermediate", "Sarcomatoid"))
# For BAP1--------------
plot_data <- metadata_bulk_cl %>% 
  group_by(phenotypic_single_cell_subtypes_based_on_bulk_rna_seq) %>% 
  summarise(
    n_total = n(),
    n_mut = sum(bap1 != "WT"),
    freq_mut = n_mut/n_total
  )

fisher.test(table(metadata_bulk_cl$phenotypic_single_cell_subtypes_based_on_bulk_rna_seq, metadata_bulk_cl$bap1))  

plot <- plot_data %>% 
  ggplot(aes(x = phenotypic_single_cell_subtypes_based_on_bulk_rna_seq, y = freq_mut, fill = phenotypic_single_cell_subtypes_based_on_bulk_rna_seq)) +
  geom_col(width = 0.75, color = "black") +
  scale_y_continuous(labels = scales::percent_format()) +
  scale_fill_manual(values = c("Epithelioid" = "#F09F57", "Non-differentiated" = "#F09F57", 
                               "Intermediate" = "#F09F57", "Sarcomatoid" = "#F09F57")) +
  labs(x = "", y = "") +
  theme_bw() +
  theme(axis.text.x = element_blank(),
        axis.title.x = element_text(size = 10), 
        axis.text.y = element_text(size = 10, color = "black"),
        axis.ticks.x = element_blank(),
        axis.title.y = element_text(size = 10),
        legend.text = element_blank(),
        legend.position = "none")
plot

png(file.path("freq_BAP1_mut_types.png"), width = 340, height = 200, res = 120)
print(plot)
dev.off()

